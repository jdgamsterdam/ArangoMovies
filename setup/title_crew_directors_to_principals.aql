/* There maybe a few Jobs that are only in Title Crew (which only lists directors and writers) that need to be added to title_pricipals for completenesss */

FOR job IN title_crew
  /*LIMIT 100*/
  LET directors = SPLIT(job.directors, ",")

  FILTER LENGTH(directors) > 0

  FOR rawDirector IN directors
    LET director = TRIM(rawDirector)

    // Skip IMDb null sentinel
    FILTER director != "\\N"

    LET hasMatch = FIRST(
      FOR p IN title_principals_view
        SEARCH p.tconst == job._key
           AND p.nconst == director
           AND p.category == "director"
        LIMIT 1
        RETURN true
    )

    FILTER hasMatch != true

/* 
    RETURN {
      ordering: "title_crew",
      tconst: job._key,
      category: "director",
      nconst: director
    }

*/
    INSERT {
      ordering: "title_crew",
      tconst: job._key,
      category: "director",
      nconst: director
    } INTO crew_temp
